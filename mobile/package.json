{
  "name": "safekey-mobile",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:init": "capacitor init",
    "cap:add:android": "capacitor add android",
    "cap:add:ios": "capacitor add ios",
    "cap:sync": "npm run build && capacitor sync",
    "cap:open:android": "capacitor open android",
    "cap:open:ios": "capacitor open ios",
    "cap:build:android": "npm run cap:sync && capacitor build android --androidreleasetype APK",
    "build:android": "npm run cap:build:android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "crypto-js": "^4.2.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "capacitor": {
    "android": {
      "path": "android"
    },
    "ios": {
      "path": "ios"
    }
  }
}
